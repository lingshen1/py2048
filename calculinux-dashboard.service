[Unit]
Description=Calculinux Graphical Dashboard Launcher
After=network.target bluez-alsa.service
Conflicts=getty@tty1.service
DefaultDependencies=no

[Service]
Type=idle
ExecStart=/bin/sh -c "tmux new-session -A -s calculinux -n Dashboard 'python3 /home/root/apps/py2048/dashboard.py'"
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
User=root
WorkingDirectory=/home/root

[Install]
WantedBy=graphical.target multi-user.target
